# ====================================================================
# Sales Performance Analytics Dashboard - Configuration File
# ====================================================================

# Application Settings
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=dev-secret-key-change-in-production-2026-sales-analytics
DEBUG=True
PORT=5000

# --------------------------------------------------------------------
# Database Configuration
# --------------------------------------------------------------------
# DB_ENGINE choices: 'mysql' or 'sqlite'
# If set to 'mysql' but MySQL is unreachable, the system will gracefully
# inform you or fall back to SQLite if ALLOW_SQLITE_FALLBACK=True.
DB_ENGINE=sqlite
ALLOW_SQLITE_FALLBACK=True

# MySQL Settings (Used when DB_ENGINE=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sales_analytics_db

# Alternative direct connection string (Overrides separate parameters if provided)
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/sales_analytics_db

# SQLite Settings (Used when DB_ENGINE=sqlite or fallback)
SQLITE_DB_PATH=data/sales_analytics.db

# --------------------------------------------------------------------
# File Upload Configuration
# --------------------------------------------------------------------
UPLOAD_FOLDER=data/uploads
EXPORT_FOLDER=data/exports
MAX_CONTENT_LENGTH=33554432  # 32MB max file upload size
ALLOWED_EXTENSIONS=csv,xlsx,xls

# --------------------------------------------------------------------
# Analytics & Cache Settings
# --------------------------------------------------------------------
PAGE_SIZE=25
MAX_EXPORT_ROWS=100000
